# Server configuration
PORT=3001
DATABASE_URL=postgresql://user:password@localhost:5432/database
GEOCODE_USER_AGENT=your-app-name
# Provide either COGNITO_JWT_PUBLIC_KEY or JWT_SECRET for JWT verification
COGNITO_JWT_PUBLIC_KEY=your-cognito-public-key
JWT_SECRET=your-jwt-secret
COGNITO_AUDIENCE=your-cognito-client-id
COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/your-user-pool
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-s3-bucket
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
CLIENT_ORIGIN=http://localhost:3000

# Client configuration
# Base URL for the client to access the API
NEXT_PUBLIC_API_URL=http://localhost:3001
