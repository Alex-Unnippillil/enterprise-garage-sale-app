{
  "name": "server",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "lint": "prettier --ignore-path ../.prettierignore --check . && eslint 'src/**/*.ts'",
    "build": "rimraf dist && npx tsc",
    "start": "npm run build && node dist/index.js",
    "dev": "npm run build && concurrently \"npx tsc -w\" \"nodemon --exec ts-node src/index.ts\"",
    "seed": "ts-node prisma/seed.ts",
    "prisma:generate": "prisma generate",
    "postprisma:generate": "shx cp -r node_modules/.prisma/client/index.d.ts ../client/src/types/prismaTypes.d.ts",
    "typecheck": "tsc --noEmit",
    "test": "jest --runTestsByPath src/__tests__/auth-mfa.test.ts src/__tests__/rbac-middleware.test.ts src/__tests__/auth-login.test.ts",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "format": "prettier --ignore-path ../.prettierignore --write .",
    "pretest": "prettier --ignore-path ../.prettierignore --check src/__tests__/auth-mfa.test.ts src/__tests__/rbac-middleware.test.ts src/__tests__/auth-login.test.ts src/controllers/auth-controllers.ts src/middleware/rbac.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": "18.x"
  },
  "description": "",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.856.0",
    "@aws-sdk/lib-storage": "^3.856.0",
    "@prisma/client": "^6.15.0",
    "@terraformer/wkt": "^2.2.1",
    "axios": "^1.11.0",
    "bcrypt": "^6.0.0",
    "body-parser": "^1.20.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "multer": "^1.4.5-lts.1",
    "otplib": "^12.0.1",
    "prisma": "^6.13.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "uuid": "^11.1.0",
    "zod": "^4.1.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/geojson": "^7946.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.17.0",
    "@types/supertest": "^6.0.3",
    "@types/terraformer__wkt": "^2.0.3",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "@typescript-eslint/parser": "^8.39.1",
    "concurrently": "^9.2.0",
    "eslint": "^9.33.0",
    "globals": "^16.3.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "shx": "^0.3.4",
    "supertest": "^7.1.1",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
